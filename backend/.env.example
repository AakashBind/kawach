# Backend Server Configuration
PORT=5000
NODE_ENV=development
DATABASE_PATH=./data/scam_shield.db
ML_SERVICE_URL=http://127.0.0.1:8000
JWT_SECRET=replace_with_production_jwt_secret_key_at_least_32_characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# Rate Limiting & Safety Bounds
MAX_UPLOAD_BYTES=5242880
WEBSITE_FETCH_TIMEOUT_MS=5000
WEBSITE_MAX_RESPONSE_BYTES=2097152
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=120
