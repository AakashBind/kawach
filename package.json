{
  "name": "ps5-scam-shield-workspace",
  "version": "1.0.0",
  "description": "Multimodal AI & Deterministic Cybersecurity Platform for Phishing & Scam Detection",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:ml": "uvicorn ml.service.app:app --host 127.0.0.1 --port 8000 --reload",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start": "node backend/dist/server.js",
    "start:railway": "./start.sh",
    "test:backend": "npm --prefix backend test",
    "test:ml": "pytest ml/tests"
  },
  "keywords": [
    "cybersecurity",
    "phishing-detection",
    "scam-shield",
    "xgboost",
    "nlp",
    "ssrf-protection",
    "fastapi",
    "react",
    "express"
  ],
  "author": "",
  "license": "MIT"
}
